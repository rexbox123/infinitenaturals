# =============================================================================
# Infinite Naturals — environment for Docker (docker compose)
# Copy to .env and fill in the blanks. NEVER commit the real .env file.
# Full reference: docs/configuration.md
# =============================================================================

APP_NAME="Infinite Naturals"
# local for development, production for the live site
APP_ENV=local
# Generate with: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
# true only in development — never in production
APP_DEBUG=true
# Public URL of the store (https://www.infinitenaturals.com in production)
APP_URL=http://localhost:8080
# Port the app container publishes on the host
APP_PORT=8080
# Domain Caddy requests an HTTPS certificate for (production "https" profile only)
APP_DOMAIN=localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=America/New_York

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (MySQL container) ----------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=infinitenaturals
DB_USERNAME=infinitenaturals
# Choose strong random passwords (e.g. openssl rand -base64 24)
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Sessions, cache, queue (stored in MySQL; no Redis needed) ----------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# true in production (HTTPS only cookies)
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- Email ---------------------------------------------------------------------
# Development: Mailpit container (open http://localhost:8025 to read mail)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
# Production: your provider's SMTP settings (Postmark, SES, Google Workspace, ...)
MAIL_FROM_ADDRESS="info@infinitenaturals.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Stripe (payments) — see docs/payments.md ----------------------------------
# Test keys start with pk_test_ / sk_test_. Use live keys only in production.
STRIPE_KEY=
STRIPE_SECRET=
# Webhook signing secret (whsec_...). From `stripe listen` in development,
# or from Dashboard → Developers → Webhooks → your endpoint in production.
STRIPE_WEBHOOK_SECRET=

# --- Store ----------------------------------------------------------------------
STORE_ORDER_PREFIX=IN-
# Minutes an unpaid card checkout holds stock (minimum effectively 31, Stripe's limit)
STORE_PAYMENT_TIMEOUT_MINUTES=60

# Reverse proxies whose X-Forwarded-* headers are trusted (* = any; fine behind Caddy/Docker)
TRUSTED_PROXIES=*
